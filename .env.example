DATABASE_URL=sqlite:///data/haproxy_manager.db
HAPROXY_CONFIG_PATH=/app/data/haproxy.cfg
HAPROXY_SOCKET_PATH=/var/run/haproxy.sock
CERT_DIR=/app/certs

# Base directory for persistent data bind mounts (haproxy config, postgres,
# valkey, varnish). Defaults to ./data relative to docker-compose.yml.
# To migrate from named Docker volumes, see deploy.md.
DATA_DIR=./data
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Valkey (Redis-compatible) cache/store
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0
# Set a strong password to require authentication on the Valkey network
VALKEY_PASSWORD=

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Task queue
TASK_QUEUE_ENABLED=true

# Automatic certificate renewal
AUTO_RENEW_ENABLED=true
AUTO_RENEW_INTERVAL_SECONDS=86400

# Coraza SPOA WAF
CORAZA_SPOA_ENABLED=true
CORAZA_SPOA_HOST=coraza-spoa
CORAZA_SPOA_PORT=9000
CORAZA_SPOA_TARGETS=coraza-spoa:9000
CORAZA_SPOA_APP=haproxy-waf
CORAZA_SPOA_CONFIG_PATH=data/coraza-spoa.yaml
CORAZA_SPOA_AUTO_RESTART=true
CORAZA_SPOE_CONFIG_PATH=data/coraza.cfg
CORAZA_SPOA_LOG_PATH=data/coraza-spoa.log

# Cap CAPTCHA service (Native provider — the built-in option)
CAPTCHA_SERVICE_URL=http://cap:3000
# CAPTCHA_SERVICE_PUBLIC_URL is no longer needed for the widget (loaded from CDN)
# but kept for backward compatibility.
CAPTCHA_SERVICE_PUBLIC_URL=http://localhost:3001
# Challenge URL is now a path on the HAProxy listener (proxied via /_cap/)
CAPTCHA_CHALLENGE_URL=/_cap/challenge
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# Path prefix for proxying captcha traffic through the HAProxy listener
CAPTCHA_PROXY_PATH=/_cap
# CDN URL for the @cap.js/widget script
CAPTCHA_WIDGET_CDN_URL=https://cdn.jsdelivr.net/npm/@cap.js/widget@0.1.57/cap.min.js
# Backend API host/port for the challenge page and verify endpoint proxy
CAPTCHA_API_BACKEND_HOST=api
CAPTCHA_API_BACKEND_PORT=8000
# Set a strong random key (required if Cap CAPTCHA service is enabled)
CAP_ADMIN_KEY=

# reCAPTCHA (Google) — alternative provider; set via UI or env
# Switch the active provider in the CAPTCHA settings page or set captcha_provider=recaptcha
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_VERSION=v2
RECAPTCHA_MIN_SCORE=0.5

# Cloudflare Turnstile — alternative provider; set via UI or env
# Switch the active provider in the CAPTCHA settings page or set captcha_provider=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# MaxMind GeoIP
MAXMIND_LICENSE_KEY=
GEOIP_DOWNLOAD_INTERVAL_HOURS=24
GEOIP_DB_PATH=data/GeoLite2-Country.mmdb
ASN_DB_PATH=data/GeoLite2-ASN.mmdb

# Security Lists
SECURITY_LISTS_DIR=data/lists
SECURITY_LISTS_FEED_POLL_INTERVAL_SECONDS=300

# Security Rules
SECURITY_RULES_BLOCK_STATUS=403

# Audit
AUDIT_PAYLOAD_MAX_BYTES=16384

# Metrics
HAPROXY_MASTER_SOCKET_PATH=/var/run/haproxy-master.sock
HAPROXY_MAXCONN=100000
METRICS_SAMPLE_INTERVAL_SECONDS=30
METRICS_RETENTION_DAYS=7
WAF_METRICS_SAMPLE_INTERVAL_SECONDS=10
WAF_METRICS_RETENTION_DAYS=7

# Caching (Memory Cache is always available; Disk Cache requires global toggle)
DISK_CACHE_ENABLED=false
CACHE_METRICS_SAMPLE_INTERVAL_SECONDS=30
CACHE_METRICS_RETENTION_DAYS=7
VARNISH_CONTAINER_NAME=varnish
VARNISH_PORT=6081
VARNISH_VCL_PATH=data/varnish/default.vcl
VARNISH_STORAGE_SIZE=1G
HAPROXY_CONTAINER_NAME=corex

# WAF rule snapshot retention (per-rule max; 0 = unlimited)
WAF_RULE_VERSION_MAX_PER_RULE=10

# WAF remote rule set downloader
CUSTOM_RULES_DIR=data/custom-rules
RULE_SET_DOWNLOAD_INTERVAL_SECONDS=300

# WAF SIEM forwarder
SIEM_FORWARDER_POLL_INTERVAL_SECONDS=5
SIEM_FORWARDER_BATCH_SIZE=100

# Response transforms (toggled via Global Options GUI; stored in DB settings).
# When enabled, the haproxy-resp-transform Rust Lua module is loaded and
# replace/inject/mask rules become selectable per-backend.
# Valkey connection for tokenize mode reuses VALKEY_HOST/PORT/DB/PASSWORD above.
RESP_TRANSFORM_ENABLED=false
RESP_TRANSFORM_DIR=data/resp-transform
RESP_TRANSFORM_RELOAD_INTERVAL_SECONDS=30
# Fallback AES key env var name for tokenize-mode rules when Valkey is down.
# The Rust module reads this env var to get the AES-256 key for fail-to-encrypt.
RESP_TRANSFORM_FALLBACK_KEY_ENV=RESP_TRANSFORM_KEY
# AES key for encrypt-mode mask rules and tokenize-mode fallback (set on the haproxy service env).
# Must be at least 32 bytes. Referenced by rule's encrypt_key_env field and the fallback key env.
# RESP_TRANSFORM_KEY=

# WAF CRS downloader
CRS_DIR=data/crs
CRS_SNAPSHOT_MAX=5

# CORS / API admin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# GUI session configuration (can be overridden per DB setting)
SESSION_TIMEOUT_MINUTES=30
SESSION_WARNING_SECONDS=60

DATAPLANE_API_ENABLED=true
DATAPLANE_API_USER=admin
# Set a strong password (required when DATAPLANE_API_ENABLED=true)
DATAPLANE_API_PASSWORD=
# Optional CA bundle for verifying the Data Plane API TLS cert (defaults to
# skipping verification for the internal self-signed cert)
DATAPLANE_API_CA_BUNDLE=

# HAProxy stats page authentication (set both to enable auth on :8404)
HAPROXY_STATS_USER=
HAPROXY_STATS_PASS=
# Set a strong admin password; if unset, a random one is generated on first start
ADMIN_PASSWORD=
LOG_LEVEL=INFO

# API Armor (Cloudflare API Shield-parity: GraphQL, schema validation, auth, profiling)
# Toggled via Global Options GUI; stored in DB settings.
API_ARMOR_ENABLED=false
# Max request body size for API Armor inspection (bytes); runtime-editable via UI
API_ARMOR_MAX_BODY_BYTES=1048576
# Rust Lua module vs pure-Lua fallback
API_ARMOR_MODULE_ENABLED=true
# API Armor data directory (schemas, api-keys, JWKS, profiles, profiling log)
API_ARMOR_DIR=data/api-armor
# Separate profiling log (written by Rust module, tailed by profiler sampler)
API_ARMOR_PROFILE_LOG_PATH=data/api-armor/profiling.log
API_ARMOR_PROFILE_LOG_MAX_BODY_BYTES=4096
API_ARMOR_PROFILE_LOG_MAX_SIZE_MB=100
# Schema learning
API_ARMOR_SCHEMA_LEARN_INTERVAL_SECONDS=30
API_ARMOR_SCHEMA_LEARN_MIN_SAMPLES=100
API_ARMOR_SCHEMA_LEARN_RETENTION_DAYS=30
# Behavioral profiling
API_ARMOR_PROFILE_RETENTION_DAYS=30
API_ARMOR_PROFILER_INTERVAL_SECONDS=30

# MCP Gateway (enables the MCP gateway proxy with policy/DLP/guardrails)
MCP_GATEWAY_ENABLED=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when MCP_GATEWAY_ENABLED=true (used to encrypt server auth secrets)
MCP_SECRETS_KEY=

# MCP Server (coreX Manager own MCP server exposing the control plane)
# When MCP_GATEWAY_ENABLED=true and MCP_SELF_REGISTER=true, the backend
# auto-registers the mcp-server into the gateway on startup.
MCP_SELF_REGISTER=true
# Bearer token for direct connections to the mcp-server (optional; if unset,
# the endpoint is open - rely on the gateway for auth when using it).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COREX_MCP_TOKEN=
# Shared secret allowing the mcp-server to bypass per-user rate limiting on
# in-process backend calls. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SERVICE_TOKEN=
