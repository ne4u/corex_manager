{
  "comment": "DNS provider metadata for ACME certificate issuance. 'acme_sh' and 'certbot' sections define the expected credential keys. Add more providers by copying this format.",
  "providers": [
    {
      "id": "cloudflare",
      "name": "Cloudflare",
      "acme_sh": {
        "code": "dns_cf",
        "env": [
          {
            "name": "CF_Token",
            "label": "API Token",
            "type": "password",
            "required": true,
            "help": "Cloudflare API token with Zone:Read and Zone:Edit permissions."
          }
        ]
      },
      "certbot": {
        "plugin": "cloudflare",
        "credentials_keys": [
          {
            "name": "dns_cloudflare_api_token",
            "label": "API Token",
            "type": "password",
            "required": true
          }
        ]
      }
    },
