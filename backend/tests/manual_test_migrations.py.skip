"""Tests for the Alembic migration path.

Verifies that `alembic upgrade head` creates all expected tables from a
fresh database, that the baseline + follow-up revisions run cleanly, and
that legacy tables are dropped by the follow-up revision.

NOTE: These tests require process isolation (env.py creates the engine at
module load, before fixtures can monkeypatch the DB URL). Run standalone:
    python backend/tests/test_migrations.py
or with pytest-forked:
    pytest backend/tests/test_migrations.py --forked
"""
import os
import tempfile

import pytest
from alembic import command
from alembic.config import Config
from sqlalchemy import create_engine, inspect, text


# All tables that should exist after `alembic upgrade head` (44 model tables
# + alembic_version = 45). Sourced from the model metadata (backend/app/models/*.py).
EXPECTED_TABLES = {
    "alembic_version",  # created by Alembic itself
    "asn_list_entries",
    "asn_lists",
    "audit_events",
    "backend_rules",
    "backends",
    "cache_configs",
    "cache_metric_snapshots",
    "cache_rules",
    "certificates",
    "cipher_suites",
    "config_snapshots",
    "csp_reports",
    "custom_error_pages",
    "dynamic_feeds",
    "fcgi_apps",
    "geo_list_entries",
    "geo_lists",
    "ja4_list_entries",
    "ja4_lists",
    "listeners",
    "log_destinations",
    "logged_fields",
    "metric_snapshots",
    "network_list_entries",
    "network_lists",
    "page_protect_policies",
    "page_protect_scripts",
    "pattern_list_entries",
    "pattern_lists",
    "rate_limits",
    "redirects",
    "request_headers",
    "response_headers",
    "rewrites",
    "security_rules",
    "servers",
    "settings",
    "tasks",
    "users",
    "waf_exceptions",
    "waf_metrics",
    "waf_rule_versions",
    "waf_rules",
    "waf_siem_integrations",
}

# Legacy tables that should NOT exist after the follow-up revision runs.
LEGACY_TABLES = {
    "audit_logs",
    "network_acls",
    "geo_acls",
    "asn_acls",
    "waf_threat_feeds",
    "waf_threat_ips",
    "waf_geo_exceptions",
}


def _alembic_config() -> Config:
    """Build an Alembic Config pointing at the app's migration scripts."""
    db_dir = os.path.join(os.path.dirname(__file__), "..", "app", "db")
    alembic_ini = os.path.join(db_dir, "alembic.ini")
    cfg = Config(alembic_ini)
    cfg.set_main_option("script_location", db_dir)
    return cfg


@pytest.fixture()
def fresh_sqlite_db(monkeypatch):
    """Create a temporary SQLite file, set DATABASE_URL env var, yield the path.
    
    env.py picks up DATABASE_URL via get_settings(), which reads from the
    environment. We set it here so env.py creates the engine bound to the
    temp DB instead of the conftest test DB.
    """
    fd, path = tempfile.mkstemp(suffix=".db")
    os.close(fd)
    db_url = f"sqlite:///{path}"
    monkeypatch.setenv("DATABASE_URL", db_url)
    yield (db_url, path)
    if os.path.exists(path):
        os.unlink(path)


def test_upgrade_head_creates_all_tables(fresh_sqlite_db):
    """A fresh DB upgraded to head must have all 44 model tables + alembic_version."""
    db_url, _ = fresh_sqlite_db
    cfg = _alembic_config()
    command.upgrade(cfg, "head")

    engine = create_engine(db_url)
    try:
        tables = set(inspect(engine).get_table_names())
    finally:
        engine.dispose()

    missing = EXPECTED_TABLES - tables
    assert not missing, f"Missing tables after upgrade: {sorted(missing)}"


def test_upgrade_head_drops_legacy_tables(fresh_sqlite_db):
    """The follow-up revision must drop legacy tables if they exist."""
    db_url, _ = fresh_sqlite_db
    cfg = _alembic_config()
    command.upgrade(cfg, "head")

    # Manually create legacy tables, then downgrade to baseline and re-upgrade.
    # The follow-up revision should drop them.
    engine = create_engine(db_url)
    try:
        with engine.connect() as conn:
            for t in LEGACY_TABLES:
                conn.execute(text(f"CREATE TABLE IF NOT EXISTS {t} (id INTEGER PRIMARY KEY)"))
            conn.commit()
    finally:
        engine.dispose()

    command.downgrade(cfg, "8b9ba74c6828")
    command.upgrade(cfg, "head")

    engine = create_engine(db_url)
    try:
        tables = set(inspect(engine).get_table_names())
    finally:
        engine.dispose()

    leftover = LEGACY_TABLES & tables
    assert not leftover, f"Legacy tables not dropped: {sorted(leftover)}"


def test_cache_rules_table_exists(fresh_sqlite_db):
    """The cache_rules table (missing from the original baseline) must exist."""
    db_url, _ = fresh_sqlite_db
    cfg = _alembic_config()
    command.upgrade(cfg, "head")

    engine = create_engine(db_url)
    try:
        tables = set(inspect(engine).get_table_names())
    finally:
        engine.dispose()

    assert "cache_rules" in tables, "cache_rules table missing after upgrade"


def test_alembic_version_is_head(fresh_sqlite_db):
    """After upgrade, the alembic_version table must point at the head revision."""
    db_url, _ = fresh_sqlite_db
    cfg = _alembic_config()
    command.upgrade(cfg, "head")

    engine = create_engine(db_url)
    try:
        with engine.connect() as conn:
            version = conn.execute(text("SELECT version_num FROM alembic_version")).scalar()
    finally:
        engine.dispose()

    assert version == "a1b2c3d4e5f6", f"Expected head revision a1b2c3d4e5f6, got {version}"


if __name__ == "__main__":
    # Run tests standalone to avoid env.py module-level engine binding issue.
    import sys
    sys.exit(pytest.main([__file__, "-v"]))
